# Copy this file to .env and fill in your webhook URL.
# .env is gitignored - never commit the real webhook URL, since anyone
# holding it can post to your channel.

# Discord channel webhook: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000/xxxxxxxxxxxx

# Optional: override the name and avatar the webhook posts under.
DISCORD_USERNAME=League Info
DISCORD_AVATAR_URL=

# Only needed for `discord-events` (the server's Events tab). Create a bot at
# https://discord.com/developers/applications, invite it with the Manage Events
# permission, then copy its token here. The guild id is your server id: enable
# Developer Mode in Discord, then right-click the server and Copy Server ID.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
